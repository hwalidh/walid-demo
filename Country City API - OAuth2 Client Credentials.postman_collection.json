{
  "info": {
    "_postman_id": "5a33af76-e3c0-4ec8-8de9-bacfd43013e9",
    "name": "Country City API - OAuth2 Client Credentials",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "7128684"
  },
  "item": [
    {
      "name": "1 - Get Keycloak Token",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const response = pm.response.json();",
              "pm.collectionVariables.set(\"keycloak_access_token\", response.access_token);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/x-www-form-urlencoded"
          }
        ],
        "body": {
          "mode": "urlencoded",
          "urlencoded": [
            {
              "key": "grant_type",
              "value": "client_credentials"
            },
            {
              "key": "client_id",
              "value": "api-gateway"
            },
            {
              "key": "client_secret",
              "value": "gateway-secret"
            }
          ]
        },
        "url": {
          "raw": "http://localhost:8080/realms/country-system/protocol/openid-connect/token",
          "protocol": "http",
          "host": [
            "localhost"
          ],
          "port": "8080",
          "path": [
            "realms",
            "country-system",
            "protocol",
            "openid-connect",
            "token"
          ]
        }
      },
      "response": []
    },
    {
      "name": "2 - Get Countries (Gateway Secured)",
      "request": {
        "auth": {
          "type": "noauth"
        },
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{keycloak_access_token}}"
          }
        ],
        "url": {
          "raw": "http://localhost:8085/countries",
          "protocol": "http",
          "host": [
            "localhost"
          ],
          "port": "8085",
          "path": [
            "countries"
          ]
        }
      },
      "response": []
    },
    {
      "name": "3 - Service Health",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{keycloak_access_token}}",
            "disabled": false
          }
        ],
        "url": {
          "raw": "http://localhost:8085/actuator/health",
          "protocol": "http",
          "host": [
            "localhost"
          ],
          "port": "8085",
          "path": [
            "actuator",
            "health"
          ]
        },
        "description": "Generated from cURL: curl -X GET \"http://localhost:8085/actuator/health\" -H \"Authorization: Bearer {{keycloak_access_token}}\""
      },
      "response": []
    },
    {
