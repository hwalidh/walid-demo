            "value": "Bearer {{keycloak_access_token}}",
            "disabled": false
          }
        ],
        "url": {
          "raw": "http://localhost:8085/cities/1",
          "protocol": "http",
          "host": [
            "localhost"
          ],
          "port": "8085",
          "path": [
            "cities",
            "1"
          ]
        },
        "description": "Generated from cURL: curl -X GET \"http://localhost:8085/cities/1\" -H \"Authorization: Bearer {{keycloak_access_token}}\""
      },
      "response": []
    },
    {
      "name": "5 - Get Cities By Country",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{keycloak_access_token}}",
            "disabled": false
          }
        ],
        "url": {
          "raw": "http://localhost:8085/countries/1/cities?page=0&size=10",
          "protocol": "http",
