{
  "info": {
    "name": "Country City API - Direct Service",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Get Countries",
      "request": {
        "method": "GET",
        "url": "http://localhost:8081/countries"
      }
    },
    {
      "name": "Get Cities By Country",
      "request": {
        "method": "GET",
        "url": "http://localhost:8081/countries/1/cities?page=0&size=10",
        "header": [
          {
            "key": "X-Gateway-Request",
            "value": "true"
          }
        ]
      }
    },
    {
      "name": "Get City Details",
      "request": {
        "method": "GET",
        "url": "http://localhost:8081/cities/1",
        "header": [
          {
            "key": "X-Gateway-Request",
            "value": "true"
          }
        ]
      }
    },
    {
      "name": "Service Health",
      "request": {
        "method": "GET",
        "url": "http://localhost:8081/actuator/health",
        "header": [
          {
            "key": "X-Gateway-Request",
            "value": "true"
          }
        ]
      }
    }
  ]
}