{
  "info": {
    "name": "Country City API - Gateway",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Get Countries",
      "request": {
        "method": "GET",
        "url": "http://localhost:8085/countries"
      }
    },
    {
      "name": "Get Cities By Country",
      "request": {
        "method": "GET",
        "url": "http://localhost:8085/countries/1/cities?page=0&size=10"
      }
    },
    {
      "name": "Get City Details",
      "request": {
        "method": "GET",
        "url": "http://localhost:8085/cities/1"
      }
    },
    {
      "name": "Gateway Health",
      "request": {
        "method": "GET",
        "url": "http://localhost:8085/actuator/health"
      }
    },
    {
      "name": "Aggregated Health",
      "request": {
        "method": "GET",
        "url": "http://localhost:8085/health/all"
      }
    }
  ]
}